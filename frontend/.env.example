# Generation endpoint. Defaults to /api/runs (the FastAPI backend, proxied by Vite to
# http://127.0.0.1:8000). Override only for a different bridge; "" disables generation.
VITE_GENERATION_URL=/api/runs
# Base for health/capabilities/properties/events. Defaults to /api.
VITE_API_BASE_URL=/api
# Hard timeout for one run (ms). Pipelines with Lean + Foundry can take a long time.
VITE_GENERATION_TIMEOUT_MS=3600000
# API keys belong only on your backend (LeVer/env.ps1), never in VITE_* variables.
